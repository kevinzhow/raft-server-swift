# Prefer ./scripts/init-deployment.sh: five independent secrets and real build identity.
# Manual setup: copy to .env, chmod 600 .env, then fill all required values.
# Never commit .env or include it in an image/archive distributed to others.
JWT_SECRET=
# Use >=32 URL-safe characters (letters, digits, underscore, hyphen) for DB passwords.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Independent AES-GCM provider master key: random 32 bytes in canonical base64.
# Keep outside PostgreSQL/Redis snapshots. Never derive it from or reuse JWT_SECRET.
CREDENTIAL_ENCRYPTION_KEY=
# Select resend or cloudflare. Credentials are supplied privately, never generated.
# Cloudflare requires Email Sending (Workers Paid), an onboarded sender domain,
# an account ID, and an API token authorized to send mail. Routing alone is insufficient.
RAFT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
FROM_EMAIL=
# Attachments use Soto and application AES-GCM encryption, including public R2 objects.
# Preserve this independent 32-byte canonical-base64 key outside the host.
ATTACHMENT_ENCRYPTION_KEY=
ATTACHMENT_STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=auto
S3_KEY_PREFIX=attachments/
# Leave empty for R2: derive the HTTPS endpoint from CLOUDFLARE_ACCOUNT_ID.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RAFT_RELEASE_SHA=
RAFT_BUILD_AT=
RAFT_RELEASE_BRANCH=

# Required internal PostgreSQL and Redis; URLs are built from the passwords above.
# BLOCKER: business persistence and migration CLI require implementation and acceptance.
RAFT_BIND_ADDRESS=127.0.0.1
# Container listener; native loopback stages can set HTTP_HOST=127.0.0.1.
HTTP_HOST=0.0.0.0
RAFT_HTTP_PORT=8080
RAFT_DAEMON_PORT=8081
RAFT_SOCKET_PORT=8082
SERVER_URL=https://raft.example.com
# Same-domain placeholder only. A real Web SPA with verification/reset routes is required.
APP_URL=https://raft.example.com

# Production Compose always requires real email verification.

# Optional TLS template; the tls profile is OFF by default.
# Use 0.0.0.0 only after DNS, ports and certificate issuance have been checked.
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
