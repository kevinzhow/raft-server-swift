diff --git a/packages/web/tests/avatarProfileMemberCacheInvalidation.behavior.test.ts b/packages/web/tests/avatarProfileMemberCacheInvalidation.behavior.test.ts
new file mode 100644
index 0000000..420e6d7
--- /dev/null
+++ b/packages/web/tests/avatarProfileMemberCacheInvalidation.behavior.test.ts
@@ -0,0 +1,191 @@
+import assert from "node:assert/strict";
+import "./helpers/domSetup";
+import api from "../src/api/client";
+import { useAuthStore } from "../src/store/authStore";
+import type { User } from "../src/store/authStore";
+import { subscribeChannelMembersChanged } from "../src/store/channelMemberEvents";
+import { useServerStore } from "../src/store/serverStore";
+
+const initialAuthState = useAuthStore.getInitialState();
+const realLoadMembers = useServerStore.getInitialState().loadMembers;
+
+const OLD_AVATAR_URL = `/api/avatars/users/${"a".repeat(32)}.webp`;
+const NEW_AVATAR_URL = `/api/avatars/users/${"b".repeat(32)}.webp`;
+const REPLACED_AVATAR_URL = `/api/avatars/users/${"c".repeat(32)}.webp`;
+
+function user(overrides: Partial<User> = {}): User {
+  return {
+    id: "avatar-user",
+    email: "avatar@example.com",
+    gravatarHash: "hash",
+    name: "avatar-user",
+    displayName: "Avatar User",
+    description: null,
+    avatarUrl: null,
+    emailVerified: true,
+    preferredLanguage: null,
+    preferredTimezone: null,
+    firstObservedTimezone: null,
+    firstObservedTimezoneAt: null,
+    lastObservedTimezone: null,
+    lastObservedTimezoneAt: null,
+    autoTranslationEnabled: false,
+    preferredTranslationMode: "off",
+    preferredTranslationDisplay: "translated",
+    preferredTimeFormat: null,
+    preferredMessageBodyFontSize: null,
+    referralSource: null,
+    referralSourceOther: null,
+    referralSourceSkippedAt: null,
+    ...overrides,
+  };
+}
+
+function avatarFile(): File {
+  return new File([new Uint8Array([0x89, 0x50, 0x4e, 0x47])], "avatar.png", { type: "image/png" });
+}
+
+interface RosterInvalidationLog {
+  readonly serverReloads: () => number;
+  readonly channelReloads: () => number;
+  readonly channelIds: () => Array<string | null>;
+  unsubscribe(): void;
+}
+
+/**
+ * Installs the two effects the fix must have: a server roster re-read through the
+ * store action, and a broadcast on the channel-member invalidation channel that
+ * `useChannelMembers` subscribes to. The channel log uses the real subscription
+ * helper, so it also proves an already-open channel listener would re-read.
+ */
+function installRosterSpies(): RosterInvalidationLog {
+  let serverReloads = 0;
+  let channelReloads = 0;
+  const channelIds: Array<string | null> = [];
+  useServerStore.setState({
+    loadMembers: async () => {
+      serverReloads += 1;
+    },
+  } as never);
+  const unsubscribe = subscribeChannelMembersChanged((channelId) => {
+    channelReloads += 1;
+    channelIds.push(channelId);
+  });
+  return {
+    serverReloads: () => serverReloads,
+    channelReloads: () => channelReloads,
+    channelIds: () => channelIds,
+    unsubscribe,
+  };
+}
+
+test.afterEach(() => {
+  localStorage.clear();
+  useAuthStore.setState(initialAuthState, true);
+  useServerStore.setState({ loadMembers: realLoadMembers } as never);
+});
+
+test("a first avatar upload refreshes the server roster and every open channel roster", async () => {
+  useAuthStore.setState({ user: user({ avatarUrl: null }) });
+  const calls: Array<{ url: string; data: unknown }> = [];
+  vi.spyOn(api, "post").mockImplementation(async (url: string, data?: unknown) => {
+    calls.push({ url, data });
+    return { data: user({ avatarUrl: NEW_AVATAR_URL }) };
+  });
+  const spies = installRosterSpies();
+  try {
+    await useAuthStore.getState().uploadAvatar(avatarFile());
+
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, "/auth/me/avatar");
+    assert.equal(useAuthStore.getState().user?.avatarUrl, NEW_AVATAR_URL);
+    assert.equal(spies.serverReloads(), 1, "the server roster must be re-read after the write");
+    assert.deepEqual(spies.channelIds(), [null], "every channel roster must be invalidated");
+  } finally {
+    spies.unsubscribe();
+  }
+});
+
+test("replacing an existing avatar refreshes the rosters instead of leaving the old URL cached", async () => {
+  useAuthStore.setState({ user: user({ avatarUrl: OLD_AVATAR_URL }) });
+  vi.spyOn(api, "post").mockResolvedValue({ data: user({ avatarUrl: REPLACED_AVATAR_URL }) });
+  const spies = installRosterSpies();
+  try {
+    await useAuthStore.getState().uploadAvatar(avatarFile());
+
+    assert.equal(useAuthStore.getState().user?.avatarUrl, REPLACED_AVATAR_URL);
+    assert.notEqual(useAuthStore.getState().user?.avatarUrl, OLD_AVATAR_URL);
+    assert.equal(spies.serverReloads(), 1);
+    assert.equal(spies.channelReloads(), 1);
+  } finally {
+    spies.unsubscribe();
+  }
+});
+
+test("a successful profile update also refreshes the rosters", async () => {
+  useAuthStore.setState({ user: user({ displayName: "Before" }) });
+  vi.spyOn(api, "patch").mockResolvedValue({ data: user({ displayName: "After" }) });
+  const spies = installRosterSpies();
+  try {
+    await useAuthStore.getState().updateProfile({ displayName: "After" });
+
+    assert.equal(useAuthStore.getState().user?.displayName, "After");
+    assert.equal(spies.serverReloads(), 1);
+    assert.deepEqual(spies.channelIds(), [null]);
+  } finally {
+    spies.unsubscribe();
+  }
+});
+
+test("a failed avatar upload leaves both rosters untouched and still rejects", async () => {
+  const before = user({ avatarUrl: OLD_AVATAR_URL });
+  useAuthStore.setState({ user: before });
+  vi.spyOn(api, "post").mockRejectedValue(
+    Object.assign(new Error("Request failed"), { response: { status: 400, data: { error: "Only image files are allowed" } } }),
+  );
+  const spies = installRosterSpies();
+  try {
+    await assert.rejects(useAuthStore.getState().uploadAvatar(avatarFile()));
+    assert.equal(spies.serverReloads(), 0, "a rejected write must not invalidate caches");
+    assert.equal(spies.channelReloads(), 0);
+    assert.equal(useAuthStore.getState().user?.avatarUrl, OLD_AVATAR_URL);
+  } finally {
+    spies.unsubscribe();
+  }
+});
+
+test("a failed profile update leaves both rosters untouched and still rejects", async () => {
+  const before = user({ displayName: "Before" });
+  useAuthStore.setState({ user: before });
+  vi.spyOn(api, "patch").mockRejectedValue(new Error("Failed to update profile"));
+  const spies = installRosterSpies();
+  try {
+    await assert.rejects(useAuthStore.getState().updateProfile({ displayName: "Nope" }));
+    assert.equal(spies.serverReloads(), 0);
+    assert.equal(spies.channelReloads(), 0);
+    assert.equal(useAuthStore.getState().user?.displayName, "Before");
+  } finally {
+    spies.unsubscribe();
+  }
+});
+
+test("a roster refresh failure never turns a successful avatar upload into a rejection", async () => {
+  useAuthStore.setState({ user: user({ avatarUrl: null }) });
+  let serverReloads = 0;
+  useServerStore.setState({
+    loadMembers: async () => {
+      serverReloads += 1;
+      throw new Error("members failed to load");
+    },
+  } as never);
+  vi.spyOn(api, "post").mockResolvedValue({ data: user({ avatarUrl: NEW_AVATAR_URL }) });
+  const unsubscribe = subscribeChannelMembersChanged(() => {});
+  try {
+    await assert.doesNotReject(useAuthStore.getState().uploadAvatar(avatarFile()));
+
+    assert.equal(serverReloads, 1);
+    assert.equal(useAuthStore.getState().user?.avatarUrl, NEW_AVATAR_URL);
+  } finally {
+    unsubscribe();
+  }
+});
