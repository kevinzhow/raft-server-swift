+static void
+md_gfm_resolve_email(MD_CTX* ctx, int mark_index, OFF line_beg, OFF line_end)
+{
+    MD_MARK* opener = &ctx->marks[mark_index];
+    MD_MARK* closer = opener + 1;
+    OFF beg = opener->beg, end = opener->end;
+    int dot = FALSE;
+    while(beg > line_beg && md_gfm_atext(CH(beg-1))) beg--;
+    if(beg == opener->beg || (beg > line_beg && CH(beg-1) == _T('/'))
+       || md_gfm_unbalanced(ctx, mark_index, beg)) return;
+    while(end < line_end) {
+        if(CH(end) == _T('.')) {
+            if(end + 1 >= line_end || !ISALNUM(end+1)) break;
+            dot = TRUE;
+        } else if(!ISALNUM(end) && !ISANYOF(end, _T("-_"))) break;
+        end++;
+    }
+    if(!dot || end <= opener->end || !ISALPHA(end-1)) return;
+    opener->beg = beg; opener->end = beg;
+    closer->beg = end; closer->end = end; closer->ch = _T('@');
+    md_resolve_range(ctx, mark_index, mark_index + 1);
+}
