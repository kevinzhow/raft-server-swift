+static int
+md_gfm_resolve_url(MD_CTX* ctx, int mark_index, OFF line_beg, OFF line_end)
+{
+    MD_MARK* opener = &ctx->marks[mark_index];
+    MD_MARK* closer = opener + 1;
+    OFF beg = opener->beg, host = (opener->ch == _T('.') ? beg : opener->end);
+    OFF end, off, domain_end, underscore = (OFF)-1, previous_underscore = (OFF)-1;
+    int seen = FALSE;
+    if(beg != line_beg) {
+        if(opener->ch == _T('.')) {
+            if(!ISWHITESPACE(beg-1) && !ISANYOF(beg-1, _T("(*_[]~"))) return FALSE;
+        } else if(ISALPHA(beg-1)) return FALSE;
+    }
+    if(md_gfm_unbalanced(ctx, mark_index, beg)) return FALSE;
+    /* Email recognition precedes WWW. This cursor visits each mark at most
+     * once, including an email whose username begins before the WWW marker. */
+    while(ctx->gfm_email_cursor < ctx->n_marks) {
+        MD_MARK* email = &ctx->marks[ctx->gfm_email_cursor];
+        if(email->ch != _T('@') || !(email->flags & MD_MARK_OPENER) || !(email->flags & MD_MARK_RESOLVED)) {
+            ctx->gfm_email_cursor++; continue;
+        }
+        OFF email_end = ctx->marks[email->next].end;
+        if(email_end <= beg) { ctx->gfm_email_cursor++; continue; }
+        if(email->beg <= beg) return FALSE;
+        break;
+    }
+    if(host >= ctx->gfm_bad_host_beg && host <= ctx->gfm_bad_host_through
+       && ctx->gfm_bad_host_through != 0) return FALSE;
+    /* Validate the domain before scanning the tail. JS examines UTF16 units
+     * here, so an astral leading surrogate is not a Unicode punctuation scalar. */
+    for(domain_end = host; domain_end < line_end; domain_end++) {
+        CHAR ch = CH(domain_end);
+        if(ch != _T('.') && ch != _T('_') && ch != _T('-')
+           && (md_is_unicode_punct__(ch) || ISUNICODEWHITESPACE(domain_end) || ISWHITESPACE(domain_end))) break;
+    }
+    OFF trimmed = domain_end;
+    if(domain_end == line_end || ISWHITESPACE(domain_end) || CH(domain_end) == _T('<'))
+        while(trimmed > host && ISANYOF(trimmed-1, _T("._"))) trimmed--;
+    for(off = host; off < trimmed; off++) {
+        if(CH(off) == _T('.')) { previous_underscore = underscore; underscore = (OFF)-1; }
+        else if(CH(off) == _T('_')) underscore = off;
+        else seen = TRUE;
+    }
+    if(!seen || underscore != (OFF)-1 || previous_underscore != (OFF)-1) {
+        ctx->gfm_bad_host_beg = host;
+        ctx->gfm_bad_host_through = (underscore != (OFF)-1 ? underscore : previous_underscore);
+        if(!seen) ctx->gfm_bad_host_through = trimmed;
+        return FALSE;
+    }
+    end = md_gfm_url_end(ctx, host, line_end);
+    opener->end = beg;
+    closer->beg = end; closer->end = end; closer->ch = opener->ch;
+    md_resolve_range(ctx, mark_index, mark_index + 1);
+    return TRUE;
 }
 
