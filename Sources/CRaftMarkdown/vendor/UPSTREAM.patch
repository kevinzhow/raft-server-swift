+/* Raft GFM literal-URL dialect adaptation, from the MIT-licensed pinned
+ * micromark-extension-gfm-autolink-literal 2.1.0 (see README/PROVENANCE).
+ * Operates inside MD4C's mark resolver, never over bridge-side prose slices. */
+static OFF
+md_gfm_url_end(MD_CTX* ctx, OFF off, OFF max_end)
+{
+    OFF trail = (OFF)-1;
+    unsigned open = 0, close = 0;
+    while(off < max_end && !ISWHITESPACE(off) && !ISUNICODEWHITESPACE(off)) {
+        CHAR ch = CH(off);
+        if(ch == _T('<')) break;
+        if(ch == _T('(')) { open++; trail = (OFF)-1; }
+        else if(ch == _T(')') && close < open) { close++; trail = (OFF)-1; }
+        else if(ISANYOF_(ch, _T("!\"')*,.:;?_~]"))) {
+            if(trail == (OFF)-1) trail = off;
+            if(ch == _T(']') && off + 1 < max_end && ISANYOF(off+1, _T("([")))
+                return trail;
+        } else if(ch == _T('&')) {
+            OFF entity_end = off + 1;
+            while(entity_end < max_end && ISALPHA(entity_end)) entity_end++;
+            if(entity_end > off + 1 && entity_end < max_end && CH(entity_end) == _T(';')) {
+                if(trail == (OFF)-1) trail = off;
+                off = entity_end;
+            } else trail = (OFF)-1;
+        } else trail = (OFF)-1;
+        off++;
+    }
+    return (trail != (OFF)-1 ? trail : off);
+}
