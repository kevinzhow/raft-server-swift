# Copy to local.env and fill in this machine's values.
#
# local.env is git-ignored. It must never contain credentials, tokens or
# secrets: the upgrade tool reads the production database container's own
# environment, and the launcher reads the production secret environment file
# itself.

# Development root: builds, caches, temporary files and qualified artifacts.
DEV_ROOT=/path/to/development-root

# Clean checkout of the deploy trunk used to resolve commits and add the
# detached build worktree.
SOURCE_REPO=/path/to/deploy-trunk-checkout

# Pinned Swift toolchain (the same path the Makefile uses).
SWIFT=/path/to/swift-6.4.1-RELEASE/usr/bin/swift
SWIFT_SDK=/path/to/swift-6.4.1-RELEASE
# Optional; needed only to stage historical releases containing the JS parser.
# Native Markdown is compiled into RaftServer and needs no JSC runtime.
JSC_LIBRARY=

# Production deployment root. The tools only read here unless `make deploy`
# runs the upgrade step.
PRODUCTION_ROOT=/path/to/production-root
RELEASE_ROOT_PREFIX=/path/to/production-root/releases/swift
BASELINE_COMMIT=0000000000000000000000000000000000000000
HOST_PLATFORM_PROOF=/path/to/development-root/qualified-artifacts/<baseline-short>-runtime-v1/host-platform.json

# Where build/stage/verify evidence is written.
ARTIFACT_ROOT=/path/to/development-root/qualified-artifacts

# Production supervision and maintenance entry points.
LAUNCHER=/path/to/production-root/production/supervision/launch-verified.py
SERVICE_UNIT=raft-swift-production-main.service
GATEWAY_FILE=/path/to/production-root/config/gateway.Caddyfile
GATEWAY_CLOSED_PROFILE=/path/to/production-root/production-canary-plan/Caddyfile.closed-all.private
GATEWAY_CONTAINER=raft-swift-local-gateway
GATEWAY_HEALTH_URL=http://127.0.0.1:18180
PRIVATE_HEALTH_URL=http://127.0.0.1:18184

# Optional: after the gateway is restored, GET this URL and print the status.
PUBLIC_VERSION_URL=

# Production PostgreSQL container and database used for the pre-upgrade backup
# and the before/after row-state diff. The password is never read by the tools.
POSTGRES_CONTAINER=raft-swift-production-postgres
PRODUCTION_DATABASE=raft_swift_production

# Scripted acceptance (scripts/acceptance/acceptance.py). The credential file
# holds the owner email/password or an owner session and is never committed.
# The restart scenarios are opt-in and only run with --full:
#   ACCEPTANCE_SERVICE_UNIT           for --restart-main
#   ACCEPTANCE_COMPUTER_SERVICE_UNIT  for --restart-computer (official Computer)
# --restart-agent uses POST /api/agents/:id/reset with mode=restart and needs
# no unit setting; its session is kept.
ACCEPTANCE_BASE_URL=http://127.0.0.1:18000
ACCEPTANCE_SOCKET_URL=ws://127.0.0.1:18001/socket.io/?EIO=4&transport=websocket
ACCEPTANCE_OWNER_CREDENTIAL_FILE=/path/to/owner-credentials.json
ACCEPTANCE_PG_CONTAINER=
ACCEPTANCE_DATABASE=
ACCEPTANCE_SERVICE_UNIT=
ACCEPTANCE_COMPUTER_SERVICE_UNIT=
